{
  "manifest_version": 1,
  "type": "device",
  "name": "OneBusAway",
  "description": {
    "en": "Real-time OneBusAway arrivals: Seattle, Tampa, San Diego… countdowns, delays and service alerts.",
    "fr": "Passages en temps réel OneBusAway : Seattle, Tampa, San Diego… attente, retards et alertes.",
    "de": "OneBusAway-Echtzeitabfahrten: Seattle, Tampa, San Diego… Wartezeit, Verspätungen, Störungen.",
    "es": "Llegadas en tiempo real de OneBusAway: Seattle, Tampa, San Diego… espera, retrasos y avisos."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-onebusaway:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-onebusaway/main/cover.png",
  "categories": ["services"],
  "countries": ["US", "AU"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Comment ça marche",
        "de": "So funktioniert es",
        "es": "Cómo funciona"
      },
      "description": {
        "en": "Choose your region and enter your API key, find your stops with the actions below, add them (with an optional route or direction filter), then create their devices in the Discover tab.",
        "fr": "Choisissez votre région et saisissez votre clé d'API, cherchez vos arrêts avec les actions ci-dessous, ajoutez-les (avec un filtre facultatif de ligne ou de direction), puis créez leurs appareils dans l'onglet Découverte.",
        "de": "Wähle deine Region und gib deinen API-Schlüssel ein, suche deine Haltestellen mit den Aktionen unten, füge sie hinzu (optional mit Linien- oder Richtungsfilter) und lege dann ihre Geräte im Tab „Entdecken“ an.",
        "es": "Elija su región e introduzca su clave de API, busque sus paradas con las acciones de abajo, añádalas (con un filtro opcional de línea o dirección) y cree sus dispositivos en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-onebusaway/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Anleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://onebusaway.org/",
          "label": {
            "en": "OneBusAway",
            "fr": "OneBusAway",
            "de": "OneBusAway",
            "es": "OneBusAway"
          }
        }
      ]
    },
    {
      "key": "region",
      "type": "select",
      "label": {
        "en": "Region",
        "fr": "Région",
        "de": "Region",
        "es": "Región"
      },
      "description": {
        "en": "The OneBusAway server of your transit network.",
        "fr": "Le serveur OneBusAway de votre réseau de transport.",
        "de": "Der OneBusAway-Server deines Verkehrsnetzes.",
        "es": "El servidor OneBusAway de su red de transporte."
      },
      "required": false,
      "default": "puget_sound",
      "options": [
        {
          "value": "puget_sound",
          "label": {
            "en": "Puget Sound (Seattle)",
            "fr": "Puget Sound (Seattle)",
            "de": "Puget Sound (Seattle)",
            "es": "Puget Sound (Seattle)"
          }
        },
        {
          "value": "tampa",
          "label": {
            "en": "Tampa Bay",
            "fr": "Tampa Bay",
            "de": "Tampa Bay",
            "es": "Tampa Bay"
          }
        },
        {
          "value": "san_diego",
          "label": {
            "en": "San Diego",
            "fr": "San Diego",
            "de": "San Diego",
            "es": "San Diego"
          }
        },
        {
          "value": "washington_dc",
          "label": {
            "en": "Washington, D.C.",
            "fr": "Washington, D.C.",
            "de": "Washington, D.C.",
            "es": "Washington, D.C."
          }
        },
        {
          "value": "adelaide",
          "label": {
            "en": "Adelaide Metro",
            "fr": "Adelaide Metro",
            "de": "Adelaide Metro",
            "es": "Adelaide Metro"
          }
        },
        {
          "value": "davis",
          "label": {
            "en": "Davis, CA (Unitrans)",
            "fr": "Davis, CA (Unitrans)",
            "de": "Davis, CA (Unitrans)",
            "es": "Davis, CA (Unitrans)"
          }
        },
        {
          "value": "custom",
          "label": {
            "en": "Other server (address below)",
            "fr": "Autre serveur (adresse ci-dessous)",
            "de": "Anderer Server (Adresse unten)",
            "es": "Otro servidor (dirección abajo)"
          }
        }
      ]
    },
    {
      "key": "server_url",
      "type": "string",
      "label": {
        "en": "Server address (other server)",
        "fr": "Adresse du serveur (autre serveur)",
        "de": "Serveradresse (anderer Server)",
        "es": "Dirección del servidor (otro servidor)"
      },
      "description": {
        "en": "Only for \"Other server\": the root of the OneBusAway API, without /api/where.",
        "fr": "Seulement pour « Autre serveur » : la racine de l'API OneBusAway, sans /api/where.",
        "de": "Nur für „Anderer Server“: die Wurzel der OneBusAway-API, ohne /api/where.",
        "es": "Solo para «Otro servidor»: la raíz de la API de OneBusAway, sin /api/where."
      },
      "placeholder": {
        "en": "e.g. https://api.example.org",
        "fr": "ex. https://api.example.org",
        "de": "z. B. https://api.example.org",
        "es": "p. ej. https://api.example.org"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d'API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "Free, asked from your transit agency (Puget Sound: oba_api_key@soundtransit.org). Empty: the public TEST key of Puget Sound, for a quick try only (heavily rate-limited).",
        "fr": "Gratuite, à demander à votre réseau (Puget Sound : oba_api_key@soundtransit.org). Vide : la clé publique TEST de Puget Sound, pour un simple essai (très limitée).",
        "de": "Kostenlos, beim Verkehrsunternehmen zu beantragen (Puget Sound: oba_api_key@soundtransit.org). Leer: der öffentliche TEST-Schlüssel von Puget Sound, nur zum Ausprobieren (stark begrenzt).",
        "es": "Gratuita, se solicita a su empresa de transporte (Puget Sound: oba_api_key@soundtransit.org). Vacía: la clave pública TEST de Puget Sound, solo para una prueba (muy limitada)."
      },
      "required": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the feature names and of the sentences sent to your scenes. Service alerts are shown as the transit agency writes them (in English). Feature names are set when a device is created.",
        "fr": "Langue des noms de fonctionnalités et des phrases envoyées à vos scènes. Les alertes de service sont affichées telles que le réseau les écrit (en anglais). Les noms sont fixés à la création de l'appareil.",
        "de": "Sprache der Funktionsnamen und der Sätze für deine Szenen. Störungsmeldungen erscheinen so, wie das Verkehrsunternehmen sie schreibt (auf Englisch). Die Namen werden beim Anlegen des Geräts festgelegt.",
        "es": "Idioma de los nombres de funciones y de las frases enviadas a sus escenas. Los avisos de servicio se muestran tal como los escribe la empresa de transporte (en inglés). Los nombres se fijan al crear el dispositivo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de mise à jour",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the arrivals of your created devices are read: one request per stop.",
        "fr": "Fréquence de lecture des passages de vos appareils créés : une requête par arrêt.",
        "de": "Wie oft die Abfahrten deiner angelegten Geräte gelesen werden: eine Anfrage pro Haltestelle.",
        "es": "Frecuencia de lectura de las llegadas de sus dispositivos creados: una solicitud por parada."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search_stops",
      "label": {
        "en": "Find stops near a point",
        "fr": "Chercher les arrêts autour d'un point",
        "de": "Haltestellen um einen Punkt suchen",
        "es": "Buscar paradas cerca de un punto"
      },
      "description": {
        "en": "Lists the stops within 400 m of a point, with their identifier and routes. Take the point from any map (right click).",
        "fr": "Liste les arrêts à moins de 400 m d'un point, avec leur identifiant et leurs lignes. Prenez le point sur n'importe quelle carte (clic droit).",
        "de": "Listet die Haltestellen im Umkreis von 400 m um einen Punkt, mit Kennung und Linien. Nimm den Punkt von einer beliebigen Karte (Rechtsklick).",
        "es": "Enumera las paradas a menos de 400 m de un punto, con su identificador y sus líneas. Tome el punto de cualquier mapa (clic derecho)."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "latitude",
          "type": "string",
          "required": true,
          "label": {
            "en": "Latitude",
            "fr": "Latitude",
            "de": "Breitengrad",
            "es": "Latitud"
          },
          "placeholder": {
            "en": "e.g. 47.6097",
            "fr": "ex. 47.6097",
            "de": "z. B. 47.6097",
            "es": "p. ej. 47.6097"
          }
        },
        {
          "key": "longitude",
          "type": "string",
          "required": true,
          "label": {
            "en": "Longitude",
            "fr": "Longitude",
            "de": "Längengrad",
            "es": "Longitud"
          },
          "placeholder": {
            "en": "e.g. -122.3331",
            "fr": "ex. -122.3331",
            "de": "z. B. -122.3331",
            "es": "p. ej. -122.3331"
          }
        },
        {
          "key": "name",
          "type": "string",
          "required": false,
          "label": {
            "en": "Part of the name (optional)",
            "fr": "Partie du nom (facultatif)",
            "de": "Teil des Namens (optional)",
            "es": "Parte del nombre (opcional)"
          },
          "placeholder": {
            "en": "e.g. Pike St",
            "fr": "ex. Pike St",
            "de": "z. B. Pike St",
            "es": "p. ej. Pike St"
          }
        }
      ]
    },
    {
      "key": "add_stop",
      "label": {
        "en": "Add a stop",
        "fr": "Ajouter un arrêt",
        "de": "Haltestelle hinzufügen",
        "es": "Añadir una parada"
      },
      "description": {
        "en": "Watches a stop: its device then appears in the Discover tab. The same stop with other filters makes another device.",
        "fr": "Suit un arrêt : son appareil apparaît ensuite dans l'onglet Découverte. Le même arrêt avec d'autres filtres donne un autre appareil.",
        "de": "Verfolgt eine Haltestelle: ihr Gerät erscheint dann im Tab „Entdecken“. Dieselbe Haltestelle mit anderen Filtern ergibt ein weiteres Gerät.",
        "es": "Sigue una parada: su dispositivo aparece luego en la pestaña Descubrir. La misma parada con otros filtros da otro dispositivo."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "stop",
          "type": "string",
          "required": true,
          "label": {
            "en": "Stop identifier",
            "fr": "Identifiant de l'arrêt",
            "de": "Kennung der Haltestelle",
            "es": "Identificador de la parada"
          },
          "description": {
            "en": "Agency and stop number, as shown by \"Find stops near a point\".",
            "fr": "Réseau et numéro de l'arrêt, tels que donnés par « Chercher les arrêts autour d'un point ».",
            "de": "Unternehmen und Haltestellennummer, wie sie „Haltestellen um einen Punkt suchen“ anzeigt.",
            "es": "Empresa y número de parada, tal como los muestra «Buscar paradas cerca de un punto»."
          },
          "placeholder": {
            "en": "e.g. 1_75403",
            "fr": "ex. 1_75403",
            "de": "z. B. 1_75403",
            "es": "p. ej. 1_75403"
          }
        },
        {
          "key": "lines",
          "type": "string",
          "required": false,
          "label": {
            "en": "Routes (empty: all)",
            "fr": "Lignes (vide : toutes)",
            "de": "Linien (leer: alle)",
            "es": "Líneas (vacío: todas)"
          },
          "description": {
            "en": "Only these routes, separated by commas.",
            "fr": "Seulement ces lignes, séparées par des virgules.",
            "de": "Nur diese Linien, durch Kommas getrennt.",
            "es": "Solo estas líneas, separadas por comas."
          },
          "placeholder": {
            "en": "e.g. 67, 77",
            "fr": "ex. 67, 77",
            "de": "z. B. 67, 77",
            "es": "p. ej. 67, 77"
          }
        },
        {
          "key": "direction",
          "type": "string",
          "required": false,
          "label": {
            "en": "Direction (empty: all)",
            "fr": "Direction (vide : toutes)",
            "de": "Richtung (leer: alle)",
            "es": "Dirección (vacío: todas)"
          },
          "description": {
            "en": "Only the departures whose destination contains this text.",
            "fr": "Seulement les départs dont la destination contient ce texte.",
            "de": "Nur Abfahrten, deren Ziel diesen Text enthält.",
            "es": "Solo las salidas cuyo destino contiene este texto."
          },
          "placeholder": {
            "en": "e.g. Northgate",
            "fr": "ex. Northgate",
            "de": "z. B. Northgate",
            "es": "p. ej. Northgate"
          }
        }
      ]
    },
    {
      "key": "remove_stop",
      "label": {
        "en": "Remove a stop",
        "fr": "Retirer un arrêt",
        "de": "Haltestelle entfernen",
        "es": "Quitar una parada"
      },
      "description": {
        "en": "Stops watching it. Its device stays in Gladys until you delete it.",
        "fr": "Arrête de le suivre. Son appareil reste dans Gladys jusqu'à ce que vous le supprimiez.",
        "de": "Beendet die Verfolgung. Das Gerät bleibt in Gladys, bis du es löschst.",
        "es": "Deja de seguirla. Su dispositivo permanece en Gladys hasta que lo elimine."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name or identifier",
            "fr": "Nom ou identifiant",
            "de": "Name oder Kennung",
            "es": "Nombre o identificador"
          },
          "placeholder": {
            "en": "e.g. 1_75403",
            "fr": "ex. 1_75403",
            "de": "z. B. 1_75403",
            "es": "p. ej. 1_75403"
          }
        }
      ]
    },
    {
      "key": "status",
      "label": {
        "en": "Show what is watched",
        "fr": "Voir ce qui est suivi",
        "de": "Verfolgte anzeigen",
        "es": "Ver lo que se sigue"
      },
      "description": {
        "en": "The server, the watched stops, their devices and the last read.",
        "fr": "Le serveur, les arrêts suivis, leurs appareils et la dernière lecture.",
        "de": "Der Server, die verfolgten Haltestellen, ihre Geräte und der letzte Abruf.",
        "es": "El servidor, las paradas seguidas, sus dispositivos y la última lectura."
      },
      "timeout_seconds": 10
    }
  ],
